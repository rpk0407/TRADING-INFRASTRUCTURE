# ═══════════════════════════════════════════════════════════
# NEXUS AI — Configuration
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════

# ─── Core ───
NEXUS_ENV=development
NEXUS_DEBUG=true
NEXUS_SECRET_KEY=change-me-to-a-random-64-char-string
NEXUS_HOST=0.0.0.0
NEXUS_PORT=8000
NEXUS_WORKERS=4

# ─── Database ───
DATABASE_URL=sqlite+aiosqlite:///./nexus.db
# For production: postgresql+asyncpg://user:pass@localhost:5432/nexus
REDIS_URL=redis://localhost:6379/0

# ─── LLM Providers (Cost Priority: Local First) ───

# Ollama — Local general-purpose models (FREE)
OLLAMA_ENABLED=true
OLLAMA_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=mixtral:8x7b
OLLAMA_FAST_MODEL=llama3.1:8b

# OpenCode — Local coding specialist models (FREE, via Ollama backend)
OPENCODE_ENABLED=true
OPENCODE_URL=http://localhost:11434
OPENCODE_DEFAULT_MODEL=deepseek-coder-v2:16b
OPENCODE_COMPLETION_MODEL=codellama:13b
OPENCODE_REVIEW_MODEL=qwen2.5-coder:7b

# OpenGravity — Hybrid agent coordination platform
OPENGRAVITY_ENABLED=true
OPENGRAVITY_API_KEY=
OPENGRAVITY_URL=http://localhost:9090

# Claude API — Premium fallback (PAID, use sparingly)
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5-20250929
CLAUDE_MAX_TOKENS=4096
CLAUDE_MONTHLY_BUDGET_USD=50.00

# ─── LLM Router Settings ───
LLM_ROUTER_STRATEGY=cost_optimized
LLM_COST_THRESHOLD=0.01
LLM_FALLBACK_CHAIN=ollama,opencode,opengravity,claude
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=3600

# ─── Agent Settings ───
AGENT_MAX_CONCURRENT=10
AGENT_TIMEOUT_SECONDS=300
AGENT_RETRY_MAX=3
AGENT_MEMORY_BACKEND=redis

# ─── Website Builder ───
WEBSITE_OUTPUT_DIR=./output/websites
WEBSITE_DEPLOY_PROVIDER=vercel
VERCEL_TOKEN=
NETLIFY_TOKEN=
CLOUDFLARE_PAGES_TOKEN=

# ─── Storage ───
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# ─── Client Portal ───
PORTAL_ENABLED=true
PORTAL_PORT=3000
PORTAL_JWT_EXPIRY_HOURS=24

# ─── Monitoring ───
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
LOG_LEVEL=INFO
LOG_FORMAT=json
